    "text": "D3 Shapes - Position 1\n\n{\n  const svg = d3.create(\"svg\").attr(\"width\", 400).attr(\"height\", 300);\n  svg.append(\"circle\").attr(\"cx\", 80).attr(\"cy\", 80).attr(\"r\", 30).attr(\"fill\", \"steelblue\");\n  svg.append(\"rect\").attr(\"x\", 200).attr(\"y\", 180).attr(\"width\", 60).attr(\"height\", 40).attr(\"fill\", \"coral\");\n  return svg.node();\n}"
  },
